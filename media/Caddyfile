# Static server for the help videos. Only /videos/* is served; no directory listing; HTTP Range works out of the box.
{
	admin off
	auto_https off
}

:80 {
	root * /srv

	handle /healthz {
		respond "ok" 200
	}

	handle /videos/* {
		header X-Content-Type-Options nosniff
		# Content addressed requests (/videos/x.mp4?v=<sha256>, the URLs the manifest hands out) never change.
		@versioned query v=*
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		# Everything else is revalidated cheaply (ETag / Last-Modified).
		header ?Cache-Control "public, max-age=300, must-revalidate"
		@manifest path /videos/manifest.json
		header @manifest Cache-Control "no-cache"
		@vtt path *.vtt
		header @vtt Content-Type "text/vtt; charset=utf-8"
		@json path *.json
		header @json Content-Type "application/json; charset=utf-8"
		file_server
	}

	handle {
		respond "not found" 404
	}
}
