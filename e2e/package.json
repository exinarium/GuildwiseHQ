{
  "name": "@aom/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "pnpm -C .. build && playwright test",
    "e2e:run": "playwright test",
    "video": "playwright test -c video/playwright.video.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preflight": "node support/preflight.ts",
    "seed": "node support/seed.ts",
    "full": "playwright test",
    "full:shift": "AOM_E2E_NO_DOCKER=1 playwright test",
    "docker": "playwright test --project=deploy-setup --project=deploy-connect --project=deploy-move --project=deploy-setup-journey",
    "regression": "playwright test",
    "summary": "node support/summary.ts",
    "deps:cache": "bash scripts/copy-cached-deps.sh",
    "test:unit": "node --test 'support/*.test.ts' '../docs/guide/*.test.mjs'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@aom/video": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.11.0",
    "pdf-parse": "1.1.1",
    "pg": "^8.0.0"
  }
}
