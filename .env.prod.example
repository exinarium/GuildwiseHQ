# Copy to .env next to docker-compose.prod.yml.
POSTGRES_PASSWORD=change-me
# Public name and URL users use. With a real DNS name Caddy obtains a Let's Encrypt certificate.
AOM_DOMAIN=aom.example.com
AOM_PUBLIC_ORIGIN=https://aom.example.com
# Invitation mail. Point at your SMTP relay (smtp://user:pass@host:587).
AOM_SMTP_URL=smtp://smtp.example.com:587
AOM_MAIL_FROM=Guildwise HQ <noreply@example.com>
# Inbound e-mail (organisations' own addresses): the platform owner's one-time set-up, see docs/SELF-HOSTING.md
# "Inbound e-mail". Set all three or none. The secret is the password of the Postmark webhook URL.
# AOM_INBOUND_PROVIDER=postmark
# AOM_INBOUND_DOMAIN=in.example.com
# AOM_INBOUND_SECRET=
# Web Push for the installed phone app, see docs/SELF-HOSTING.md "Web Push". Generate the pair once per environment with
# `docker compose -f docker-compose.prod.yml exec app node dist/vapid-generate.mjs`; set all three or none (without them push is off and Settings says so).
# Changing the pair later makes every device subscribe again.
# AOM_VAPID_PUBLIC_KEY=
# AOM_VAPID_PRIVATE_KEY=
# AOM_VAPID_SUBJECT=mailto:ops@example.com
# Which proxies may set X-Forwarded-For (the client address every per-address limit uses). The compose file trusts
# private addresses, which covers the bundled Caddy container. Change it only when another proxy or a CDN sits in front,
# see docs/SELF-HOSTING.md "Running behind a reverse proxy". Never set true on a server reachable without the proxy.
# AOM_TRUST_PROXY=loopback,uniquelocal
# Local test with Caddy's internal CA instead: AOM_DOMAIN=localhost, AOM_PUBLIC_ORIGIN=https://localhost:9443,
# AOM_HTTPS_PORT=9443, AOM_HTTP_PORT=9080.
# AOM_HTTP_PORT=80
# AOM_HTTPS_PORT=443

# Optional: body limits shared by the app and the bundled proxy (docs/SELF-HOSTING.md "Proxy logs and body limits").
# The compose file passes each one to both, so they stay equal. Defaults shown.
# AOM_STORAGE_MAX_FILE_BYTES=26214400   # public form file part, at most 104857600
# AOM_JOURNEY_HOOK_MAX_BYTES=65536      # journey webhook /hooks/in/*
# AOM_RELAY_MAX_BODY_BYTES=1048576      # relay /relay/in/*, at most 4194304 (the proxy caps this route at 4 MiB)
# Per kind relay limits, kind=bytes pairs (each 1 to 4194304). whatsapp_cloud is 3145728 (Meta's 3 MB payloads) unless set here.
# AOM_RELAY_MAX_BODY_BYTES_BY_KIND=whatsapp_cloud=3145728

# REQUIRED. Encrypts two-factor (TOTP) seeds and connected-account tokens at rest; the server will not start in
# production without it. Set a long random value (`openssl rand -base64 32`) and keep it with your backups.
AOM_SECRET_KEY=change-me-to-a-long-random-string

# Optional: YouTube videos (docs/SELF-HOSTING.md "YouTube videos"). The OAuth client the channel's refresh token was made with;
# the video worker runs with `docker compose --profile video up -d`.
# AOM_YOUTUBE_CLIENT_ID=
# AOM_YOUTUBE_CLIENT_SECRET=
