{
  "name": "@aom/runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "aom-runner": "./dist/aom-runner.mjs",
    "aom": "./dist/aom.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:smoke": "AOM_CLAUDE_SMOKE=1 vitest run test/claude-smoke.test.ts"
  },
  "dependencies": {
    "@aom/shared": "workspace:*",
    "commander": "^14.0.0",
    "execa": "^9.0.0",
    "picomatch": "^4.0.0",
    "ws": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.0",
    "@types/ws": "^8.0.0",
    "tsup": "^8.5.1",
    "undici": "^8.11.2"
  }
}
