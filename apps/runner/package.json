{
  "name": "@aom/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "guildwise-runner": "./dist/aom-runner.mjs",
    "aom-runner": "./dist/aom-runner.mjs",
    "aom": "./dist/aom.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:smoke": "AOM_CLAUDE_SMOKE=1 vitest run test/claude-smoke.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.98",
    "@ai-sdk/google": "4.0.113",
    "@ai-sdk/openai": "4.0.110",
    "@ai-sdk/openai-compatible": "3.0.86",
    "@aom/shared": "workspace:*",
    "ai": "7.0.164",
    "commander": "^15.1.0",
    "execa": "^9.0.0",
    "picomatch": "^4.0.0",
    "playwright-core": "^1.65.0",
    "ws": "^8.22.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.0",
    "@types/ws": "^8.0.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "pdf-parse": "2.4.5",
    "tsup": "^8.5.1",
    "undici": "^8.12.4"
  }
}
