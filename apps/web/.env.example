# VITE_MSW=1 serves the API from in-browser MSW mocks (dev only). Leave unset to use the real server (see API_PROXY_TARGET).
VITE_MSW=

# Origin the dev (vite) and preview (vite preview) proxy forwards the API to. Default http://127.0.0.1:4600.
# Example for a test environment: API_PROXY_TARGET=http://localhost:24150. Restart the server after changing it.
API_PROXY_TARGET=
