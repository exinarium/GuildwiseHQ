{
  "name": "@aom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --out-dir dist --noExternal @aom/shared",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "projections:rebuild": "tsx scripts/projections-rebuild.ts"
  },
  "dependencies": {
    "@aom/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "cron-parser": "^5.0.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.0.0",
    "ws": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.0.0",
    "tsup": "^8.5.1"
  }
}
