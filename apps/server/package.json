{
  "name": "@aom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing/*": "./test/helpers/*",
    "./test-files/*": "./test/*",
    "./scripts/*": "./scripts/*",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "AOM_MOCK_UI=${AOM_MOCK_UI:-true} AOM_SMTP_URL=${AOM_SMTP_URL:-smtp://127.0.0.1:1026} tsx watch src/main.ts",
    "build": "tsup && rm -rf dist/video-assets && cp -r ../../packages/video/assets dist/video-assets && rm -rf dist/release-notes && mkdir -p dist/release-notes && cp ../../CHANGELOG.md dist/release-notes/CHANGELOG.md && cp -r ../web/src/whats-new/entries dist/release-notes/whats-new && node scripts/build-library-manifest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "superadmin:create": "tsx scripts/superadmin-create.ts",
    "superadmin:reset-password": "tsx scripts/superadmin-reset-password.ts",
    "orgs:migrate": "tsx scripts/orgs-migrate.ts",
    "restructure:migrate": "tsx scripts/restructure-migrate.ts",
    "ranking:migrate": "tsx scripts/ranking-migrate.ts",
    "legacy-feeds-fixture": "tsx test/fixtures/run-legacy-feeds.ts",
    "assistant:pack": "tsx scripts/build-assistant-pack.ts",
    "mails:render": "tsx scripts/render-mails.ts",
    "projections:rebuild": "tsx scripts/projections-rebuild.ts",
    "vapid:generate": "tsx scripts/vapid-generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@aom/shared": "workspace:*",
    "@aom/video": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "cron-parser": "^5.0.0",
    "fastify": "^5.12.6",
    "fastify-type-provider-zod": "^6.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.0.0",
    "playwright-core": "^1.63.0",
    "postal-mime": "^4.0.8",
    "ssh2": "^1.17.0",
    "web-push": "3.6.7",
    "ws": "^8.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.0.0",
    "tsup": "^8.5.1"
  }
}
