{
  "name": "@aom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "AOM_MOCK_UI=${AOM_MOCK_UI:-true} AOM_SMTP_URL=${AOM_SMTP_URL:-smtp://127.0.0.1:1026} tsx watch src/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "superadmin:create": "tsx scripts/superadmin-create.ts",
    "superadmin:reset-password": "tsx scripts/superadmin-reset-password.ts",
    "orgs:migrate": "tsx scripts/orgs-migrate.ts",
    "restructure:migrate": "tsx scripts/restructure-migrate.ts",
    "ranking:migrate": "tsx scripts/ranking-migrate.ts",
    "legacy-feeds-fixture": "tsx test/fixtures/run-legacy-feeds.ts",
    "mails:render": "tsx scripts/render-mails.ts",
    "projections:rebuild": "tsx scripts/projections-rebuild.ts"
  },
  "dependencies": {
    "@aom/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "cron-parser": "^5.0.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.0.0",
    "tsup": "^8.5.1"
  }
}
