# Server (apps/server). Dev defaults shown; see docs/ARCHITECTURE.md section 22.
DATABASE_URL=postgres://aom:aom@127.0.0.1:5433/aom
AOM_PORT=4600
AOM_HOST=127.0.0.1
AOM_PUBLIC_ORIGIN=http://localhost:5173
# Dev Mailpit from docker-compose.dev.yml: SMTP on 1026, web UI http://localhost:8026
AOM_SMTP_URL=smtp://127.0.0.1:1026
AOM_MAIL_FROM="Guildwise HQ <noreply@aom.local>"
AOM_MIGRATE_ON_BOOT=true
AOM_SERVE_WEB=false
LOG_LEVEL=info
# Test only: enables POST /api/test/clock {offsetMs}
# AOM_TEST_CLOCK=1
# Show the mock-runtime card fields (Mock script, ...) in the UI and accept them on the API (dev and e2e only)
# AOM_MOCK_UI=true

# Tests (server integration) use the aom_test database
# DATABASE_URL=postgres://aom:aom@127.0.0.1:5433/aom_test

# Runner (apps/runner)
# AOM_RUNNER_HOME=~/.aom-runner
